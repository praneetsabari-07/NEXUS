# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3005"

# GOOGLE_MAPS_API_KEY: Optional Google Maps Platform API key (for Google Maps Geocoding & Weather data layers)
VITE_GOOGLE_MAPS_API_KEY=""

# WEATHER_API_KEY: Optional custom Weather API key (OpenWeatherMap / WeatherAPI)
# (Note: Live climate telemetrics automatically run out-of-the-box via Open-Meteo Global WMO Satellite Feed if no custom key is provided)
VITE_WEATHER_API_KEY=""
